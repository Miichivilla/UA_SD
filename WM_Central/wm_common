_ANSI_COLORS = {
    "red": "\033[91m", "green": "\033[92m", "yellow": "\033[93m", "blue": "\033[94m",
    "cyan": "\033[96m", "orange": "\033[38;5;208m", "gray": "\033[90m", "bold": "\033[1m",
}
_ANSI_RESET = "\033[0m"
_log_lock = threading.Lock()


def color(text, col=None):
    if not col or col not in _ANSI_COLORS:
        return str(text)
    return f"{_ANSI_COLORS[col]}{text}{_ANSI_RESET}"


def log(tag, msg, col=None):
    """Imprime '[HH:MM:SS] [TAG] mensaje' de forma segura entre hilos."""
    timestamp = datetime.now().strftime("%H:%M:%S")
    with _log_lock:
        print(f"[{timestamp}] [{tag}] {color(msg, col)}", flush=True)


def env(name, default=None):
    """Lee una variable de entorno (permite parametrizar sin tocar el código)."""
    value = os.environ.get(name)
    return value if value not in (None, "") else default


def new_id(prefix="R"):
    """Identificador corto y único para peticiones de riego."""
    return f"{prefix}-{uuid.uuid4().hex[:8]}"


def parse_hostport(s, default_port=None):
    """'host:puerto' -> ('host', puerto)."""
    s = str(s).strip()
    if ":" in s:
        host, port = s.rsplit(":", 1)
        return host, int(port)
    if default_port is None:
        raise ValueError(f"Se esperaba host:puerto y se recibió '{s}'")
    return s, int(default_port)


def split_msg(msg):
    """'CODIGO#campo1#campo2' -> ['CODIGO', 'campo1', 'campo2']"""
    return (msg or "").split("#")


# Trama:  <STX> DATA <ETX> <LRC>     LRC = XOR byte a byte de DATA
# El receptor responde con <ACK> si el LRC es correcto o <NACK> si no (el emisor reintenta).
STX, ETX, ACK, NACK = b"\x02", b"\x03", b"\x06", b"\x15"
FORMAT = "utf-8"
MAX_DATA = 4096
MAX_RETRIES = 3


class ConnectionClosed(Exception):
    """El otro extremo ha cerrado la conexión."""


class ProtocolError(Exception):
    """Trama mal formada, LRC incorrecto repetidamente o respuesta inesperada."""


class BusError(Exception):
    """Error de Kafka."""


def lrc(data: bytes) -> int:
    result = 0
    for byte in data:
        result ^= byte
    return result


def build_frame(text: str) -> bytes:
    data = text.encode(FORMAT)
    return STX + data + ETX + bytes([lrc(data)])


class FramedConn:
    """Conexión TCP que intercambia mensajes de texto empaquetados en tramas.
    Los protocolos de la práctica son siempre 'pregunta -> respuesta', así que no
    hay dos mensajes cruzándose a la vez por el mismo socket."""

    def __init__(self, sock, peer=None):
        self.sock = sock
        self.peer = peer
        self.buffer = b""
        self.lock = threading.Lock()

    # -- lectura de bytes con timeout
    def _read_bytes(self, n, timeout):
        self.sock.settimeout(timeout)
        while len(self.buffer) < n:
            chunk = self.sock.recv(1024)          # socket.timeout (=TimeoutError) si vence
            if not chunk:
                raise ConnectionClosed("conexión cerrada por el otro extremo")
            self.buffer += chunk
        result, self.buffer = self.buffer[:n], self.buffer[n:]
        return result

    def _receive_frame(self, timeout):
        # 1) buscar STX (se descarta cualquier basura previa)
        while self._read_bytes(1, timeout) != STX:
            pass
        # 2) leer hasta ETX
        data = b""
        while True:
            byte = self._read_bytes(1, timeout)
            if byte == ETX:
                break
            data += byte
            if len(data) > MAX_DATA:
                raise ProtocolError("trama demasiado larga")
        # 3) LRC
        return data, self._read_bytes(1, timeout)[0]

    # -- API pública
    def send(self, text, timeout=5):
        """Envía una trama y espera su ACK (reintenta si llega NACK)."""
        frame = build_frame(text)
        for _ in range(MAX_RETRIES):
            self.sock.sendall(frame)
            if self._read_bytes(1, timeout) == ACK:
                return
        raise ProtocolError("el receptor rechazó la trama (NACK) repetidamente")

    def recv(self, timeout=None):
        """Espera una trama, comprueba el LRC y responde ACK/NACK. Devuelve el texto."""
        for _ in range(MAX_RETRIES):
            data, received_lrc = self._receive_frame(timeout)
            if lrc(data) == received_lrc:
                self.sock.sendall(ACK)
                return data.decode(FORMAT)
            self.sock.sendall(NACK)
        raise ProtocolError("LRC incorrecto repetidamente")

    def request(self, text, timeout=5):
        """send() + recv() de la respuesta."""
        with self.lock:
            self.send(text, timeout)
            return self.recv(timeout)

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass


def connect(host, port, timeout=5):
    sock = socket.create_connection((host, int(port)), timeout=timeout)
    sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
    return FramedConn(sock, (host, port))


# ============================================================================ 3. Kafka
T_REQ = "wm.requests"        # FO / WS (riego manual) -> Central : peticiones de riego
T_CMD = "wm.ws.commands"     # Central -> Engine : START, STOP, BLOCK, ACTIVATE, DENIED
T_EVT = "wm.ws.events"       # Engine -> Central : START_ACK/NACK, TELEMETRY, END
T_FO = "wm.fo.notify"        # Central -> FO : INFO, AUTHORIZED, DENIED, TELEMETRY, INCIDENT, END
T_STATUS = "wm.status"       # Central -> todos : estado de todas las WS cada segundo (latido)
ALL_TOPICS = [T_REQ, T_CMD, T_EVT, T_FO, T_STATUS]

try:
    from confluent_kafka import Consumer, KafkaError, KafkaException, Producer, TopicPartition, OFFSET_END
    from confluent_kafka.admin import AdminClient, NewTopic
except ImportError:            # permite importar el módulo sin Kafka (p. ej. el Monitor)
    Producer = None


class KafkaBus:
    def __init__(self, bootstrap, client_id="wm"):
        if Producer is None:
            raise BusError("falta la librería confluent-kafka (pip install confluent-kafka)")
        self.bootstrap = bootstrap
        self.client_id = client_id
        self.admin_client = AdminClient({"bootstrap.servers": bootstrap})
        try:
            self.admin_client.list_topics(timeout=5)   # comprueba que el broker responde
        except KafkaException as e:
            raise BusError(f"broker no disponible: {e}")
        self.producer = Producer({
            "bootstrap.servers": bootstrap,
            "client.id": client_id,
            "acks": "all",
            "enable.idempotence": True,               # sin duplicados al reintentar
            "message.timeout.ms": 15000,
        })

    def ensure_topics(self):
        topic_config = {T_STATUS: {"retention.ms": "60000"}}  # el latido no hace falta guardarlo
        new_topics = [NewTopic(t, num_partitions=1, replication_factor=1, config=topic_config.get(t, {}))
                      for t in ALL_TOPICS]
        for topic, future in self.admin_client.create_topics(new_topics).items():
            try:
                future.result(10)
            except KafkaException as e:
                if e.args[0].code() != KafkaError.TOPIC_ALREADY_EXISTS:
                    raise

    @staticmethod
    def _encode_message(obj):
        obj = dict(obj)
        obj.setdefault("ts", time.time())   # la Central lee esta clave "ts" para descartar peticiones viejas
        return json.dumps(obj).encode(FORMAT)

    def send(self, topic, obj, key=None):
        self.producer.produce(topic, self._encode_message(obj), key=key)
        self.producer.poll(0)

    def send_sync(self, topic, obj, key=None, timeout=5):
        result = {}

        def on_delivery(err, _msg):
            result["err"] = err
        try:
            self.producer.produce(topic, self._encode_message(obj), key=key, on_delivery=on_delivery)
        except Exception:
            return False
        deadline = time.time() + timeout
        while "err" not in result and time.time() < deadline:
            self.producer.poll(0.1)
        return "err" in result and result["err"] is None

    def tail_consumer(self, topics):
        consumer = Consumer({"bootstrap.servers": self.bootstrap, "group.id": f"tail-{uuid.uuid4().hex}",
                             "enable.auto.commit": False, "auto.offset.reset": "latest"})
        partitions = []
        metadata = consumer.list_topics(timeout=10)
        for topic in topics:
            for partition in metadata.topics[topic].partitions:
                partitions.append(TopicPartition(topic, partition, OFFSET_END))
        consumer.assign(partitions)
        return consumer

    def group_consumer(self, topics, group):
        consumer = Consumer({"bootstrap.servers": self.bootstrap, "group.id": group,
                             "enable.auto.commit": True, "auto.offset.reset": "earliest"})
        consumer.subscribe(topics)
        return consumer


def poll_json(consumer, timeout=1.0):
    msg = consumer.poll(timeout)
    if msg is None or msg.error():
        return None, None
    raw = msg.value()
    try:
        return json.loads(raw.decode(FORMAT)), raw
    except Exception:
        return None, raw


def connect_kafka(bootstrap, client_id, say):
    warned = False
    while True:
        try:
            bus = KafkaBus(bootstrap, client_id)
            bus.ensure_topics()
            say(f"Conectado a Kafka ({bootstrap})", "green")
            return bus
        except Exception as e:
            if not warned:
                say(f"Imposible conectar con Kafka ({bootstrap}): {e}. Reintentando...", "red")
                warned = True
            time.sleep(3)